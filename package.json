{
  "name": "irlcommons.org",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "python3 scripts/prepare.py && astro build",
    "test": "node --test scripts/check.test.mjs scripts/banned-phrases.test.mjs scripts/budget.test.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build && npm test",
    "check:browser": "node --test scripts/browser.test.mjs",
    "budget": "node scripts/budget.mjs",
    "snapshots": "node scripts/snapshots.mjs",
    "serve": "node scripts/serve.mjs"
  },
  "dependencies": {
    "@irl-commons/data": "0.3.0",
    "astro": "7.4.12"
  },
  "devDependencies": {
    "axe-core": "4.14.0",
    "html-validate": "11.21.1",
    "playwright-core": "1.65.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.20.0"
}
