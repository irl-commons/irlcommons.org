---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const {shell} = Astro.props;
---
<!doctype html>
<html lang={shell.meta.lang}>
<head><Fragment set:html={shell.head} /><script is:inline src="/assets/site.js"></script></head>
<body><Header html={shell.before} /><main id="main" class={shell.meta.main_class || undefined}><slot /></main><Footer html={shell.after} /></body>
</html>
